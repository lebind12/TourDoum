# infra/aws/.env.aws.example
# ADR-0013 사전 인프라 — k6-operator on EKS Seoul 부하 발생기 자격 증명 템플릿.
#
# 사용법:
#   1) cp infra/aws/.env.aws.example infra/aws/.env.aws
#   2) 실제 키/ARN 입력 (또는 ~/.aws/credentials 사용 권장)
#   3) infra/aws/README.md의 IAM 최소 권한 정책을 적용한 IAM 사용자/역할로 발급
#
# 보안:
#   - 이 파일에는 placeholder만. 실제 키는 .env.aws (gitignore)에만.
#   - 가능하면 long-lived access key 대신 AWS_PROFILE 또는 STS AssumeRole 사용.
#   - 키는 워크스페이스 외부(~/.aws/credentials) 보관 권장.

# === 필수 ===
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=ap-northeast-2

# === 선택: profile 분리 (권장) ===
# ~/.aws/credentials 에 [tourdoum-loadtest] 섹션을 두고 이 변수만 사용.
AWS_PROFILE=tourdoum-loadtest

# === 선택: role-based ===
# IAM Role 사용 시 STS AssumeRole 또는 IRSA(EKS) 권장.
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/tourdoum-loadtest-role

# === EKS / k6-operator ===
EKS_CLUSTER_NAME=tourdoum-loadtest-eks
K6_OPERATOR_NAMESPACE=k6-operator-system
