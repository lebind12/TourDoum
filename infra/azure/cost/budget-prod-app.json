{
	"$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"metadata": {
		"_comment": "ADR-0013 결정 (14) Cost guardrail — prod-app RG budget. Phase 1: notification only (자동 차단 chain X). 적용은 architect/사용자 명시 승인 후 `az deployment group create -g rg-tourdoum-prod-app -f budget-prod-app.json`."
	},
	"parameters": {
		"budgetName": {
			"type": "string",
			"defaultValue": "budget-tourdoum-prod-app"
		},
		"amount": {
			"type": "int",
			"defaultValue": 50,
			"metadata": { "description": "USD. ADR-0013 §14: prod-app soft cap $50." }
		},
		"startDate": {
			"type": "string",
			"defaultValue": "2026-05-01",
			"metadata": { "description": "월 budget 시작일 (YYYY-MM-01)." }
		},
		"endDate": {
			"type": "string",
			"defaultValue": "2027-12-31"
		},
		"contactEmails": {
			"type": "array",
			"defaultValue": ["lebind11@gmail.com"]
		}
	},
	"resources": [
		{
			"type": "Microsoft.Consumption/budgets",
			"apiVersion": "2023-05-01",
			"name": "[parameters('budgetName')]",
			"properties": {
				"category": "Cost",
				"amount": "[parameters('amount')]",
				"timeGrain": "Monthly",
				"timePeriod": {
					"startDate": "[parameters('startDate')]",
					"endDate": "[parameters('endDate')]"
				},
				"notifications": {
					"actual_50": {
						"enabled": true,
						"operator": "GreaterThan",
						"threshold": 50,
						"thresholdType": "Actual",
						"contactEmails": "[parameters('contactEmails')]"
					},
					"actual_80": {
						"enabled": true,
						"operator": "GreaterThan",
						"threshold": 80,
						"thresholdType": "Actual",
						"contactEmails": "[parameters('contactEmails')]"
					},
					"forecast_100": {
						"enabled": true,
						"operator": "GreaterThan",
						"threshold": 100,
						"thresholdType": "Forecasted",
						"contactEmails": "[parameters('contactEmails')]"
					}
				}
			}
		}
	]
}
