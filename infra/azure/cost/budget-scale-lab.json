{
	"$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"metadata": {
		"_comment": "ADR-0013 결정 (14) Cost guardrail — scale-lab RG budget. 단기 실험 RG, $30 alert. 적용: `az deployment group create -g rg-tourdoum-scale-lab -f budget-scale-lab.json`."
	},
	"parameters": {
		"budgetName": {
			"type": "string",
			"defaultValue": "budget-tourdoum-scale-lab"
		},
		"amount": {
			"type": "int",
			"defaultValue": 30,
			"metadata": {
				"description": "USD. ADR-0013 §14: scale-lab soft cap $30 — 실험 종료 후 RG 삭제 권고."
			}
		},
		"startDate": {
			"type": "string",
			"defaultValue": "2026-05-01"
		},
		"endDate": {
			"type": "string",
			"defaultValue": "2027-12-31"
		},
		"contactEmails": {
			"type": "array",
			"defaultValue": ["lebind11@gmail.com"]
		}
	},
	"resources": [
		{
			"type": "Microsoft.Consumption/budgets",
			"apiVersion": "2023-05-01",
			"name": "[parameters('budgetName')]",
			"properties": {
				"category": "Cost",
				"amount": "[parameters('amount')]",
				"timeGrain": "Monthly",
				"timePeriod": {
					"startDate": "[parameters('startDate')]",
					"endDate": "[parameters('endDate')]"
				},
				"notifications": {
					"actual_50": {
						"enabled": true,
						"operator": "GreaterThan",
						"threshold": 50,
						"thresholdType": "Actual",
						"contactEmails": "[parameters('contactEmails')]"
					},
					"actual_80": {
						"enabled": true,
						"operator": "GreaterThan",
						"threshold": 80,
						"thresholdType": "Actual",
						"contactEmails": "[parameters('contactEmails')]"
					},
					"actual_100": {
						"enabled": true,
						"operator": "GreaterThan",
						"threshold": 100,
						"thresholdType": "Actual",
						"contactEmails": "[parameters('contactEmails')]"
					}
				}
			}
		}
	]
}
