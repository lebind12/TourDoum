<?xml version="1.0" encoding="UTF-8"?>
<!--
  ETL 전용 Logback 설정.
  TourApiSqlGeneratorMain 실행 시 -Dlogback.configurationFile=logback-etl.xml 로 지정.
  모든 로그를 System.err 로 출력해 stdout(SQL INSERT 문)과 분리한다.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
