# TourDoum Backend — 환경변수 예시
# 실제 값은 .env 에 설정 (절대 커밋 금지)

# MySQL
DB_URL=jdbc:mysql://localhost:3306/tourdoum?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=tourdoum
DB_PASSWORD=tourdoum

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# TourAPI (한국관광공사) — 발급 후 입력, 없어도 앱 부팅 가능
TOUR_API_KEY=

# Spring profile
SPRING_PROFILES_ACTIVE=dev
