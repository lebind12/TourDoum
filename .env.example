# Copy to .env and fill in. Never commit .env.

# --- LLM / Codex ---
OPENAI_API_KEY=

# --- DB (matches infra/docker/docker-compose.yml defaults for local dev) ---
DB_URL=jdbc:mysql://localhost:3306/tourdoum?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=tourdoum
DB_PASSWORD=tourdoum

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- App secrets ---
JWT_SECRET=

# --- Public APIs ---
# 한국관광공사 TourAPI 4.0 (KorService2) — https://www.data.go.kr/data/15101578/openapi.do
TOUR_API_KEY=

